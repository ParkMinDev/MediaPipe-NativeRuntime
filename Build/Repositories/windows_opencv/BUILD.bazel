licenses(["notice"])

exports_files(["LICENSE"])

config_setting(
    name = "opt_build",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "dbg_build",
    values = {"compilation_mode": "dbg"},
)

cc_library(
    name = "opencv",
    srcs = select({
        ":opt_build": [
            "x64/vc15/lib/opencv_world3410.lib",
            "x64/vc15/bin/opencv_world3410.dll",
        ],
        ":dbg_build": [
            "x64/vc15/lib/opencv_world3410d.lib",
            "x64/vc15/bin/opencv_world3410d.dll",
        ],
    }),
    hdrs = glob(["include/opencv2/**/*.h*"]),
    includes = ["include/"],
    linkstatic = 1,
    visibility = ["//visibility:public"],
)
